# 值班研究员（L3）定时唤醒（WP15 任务 4；规格 §10.4）
#
# 时刻依据：基础链的 enqueue_research 在各市场链尾（digest 之后）入队——
# 本机默认 SH 16:00 收盘，链上 sync/quality/factors_snapshot/sentiment_snapshot/
# research_snapshot/build_plan/enqueue_research 约 16:15–16:30 跑完；16:50 唤醒留出余量。
# 港股链 16:30 起、美股链次日 05:30 起：它们的任务在下一次唤醒被消费（**任务不丢、只延后**，
# 规格 §10.4 的兜底语义），需要更早看到就在 Web 开会话，由「会话打开补跑」消费。
# 周末/节假日不做交易日判定：非交易日 enqueue_research 本就不跑，唤醒后队列为空、立即收工。
# cron 等价行（分 时 日 月 周；用户与路径按实际替换）：
#   50 16 * * 1-5 /home/<user>/dsh-trading-agents/scripts/research_duty.sh >> ~/.dsh/logs/research-duty-cron.log 2>&1
[Unit]
Description=quant platform duty researcher timer (L3)

[Timer]
OnCalendar=Mon..Fri 16:50
# 关机/睡眠错过触发 → 恢复后补跑一次（与队列「不丢只延后」的兜底语义一致）
Persistent=true
Unit=research-duty.service

[Install]
WantedBy=timers.target
