# 调度器角色专用镜像：容器内需要跑 dsh 运行时（headless 通道）。
#
# 两个实测结论决定了这个镜像的形态：
#  1) 官方 node:22-alpine 是 musl，缺 glibc 下的 node-pty 原生模块，dsh 基础 bundle 导入
#     dsh-subprocess-local 时直接抛 `Failed to load native module: pty`；因此必须用 glibc 基础镜像。
#  2) 在 aarch64 上 `npm install -g @deepseek-ai/dsh` 会尝试编译 node-pty，构建非常慢且在本环境未成功；
#     而**把宿主机已装好的 dsh（含预编译 node-pty）只读挂进容器**可直接运行（实测容器内
#     `/npx/node_modules/.bin/dsh --version` → 0.1.5-rc.2）。故本镜像不装 dsh，而是挂载复用：
#       docker run ... -v /path/to/npx-cache:/npx:ro -e DSH_BIN=/npx/node_modules/.bin/dsh
#    （若你的平台有 linux/amd64 或可联网编译，也可自行改为 RUN npm install -g @deepseek-ai/dsh。）
#
# 容器内跑 headless 还需要**预置运行时 home**：DSH_HOME 里要有 profiles/（可从配置卷初始化复制）
# 与模型凭据；缺任一项时 headless 会以 exit 1 如实失败并写明诊断。
FROM node:22-bookworm-slim

WORKDIR /app
ENV NODE_ENV=production
COPY package.json ./
COPY server ./server
COPY web ./web
# 运行时数据与 dsh 运行时 home（具名卷默认归 root，必须预建并授权给 node 用户，
# 否则实测报 EACCES: mkdir '/dsh-runtime/profiles/headless'）
RUN mkdir -p /app/data /dsh-runtime && chown -R node:node /app /dsh-runtime
USER node
ENV QUANT_V3_HOST=0.0.0.0
ENV QUANT_V3_PORT=8407
ENV QUANT_V3_DATA=/app/data
ENV DSH_HOME=/dsh-runtime
# 默认指向挂载进来的 dsh（见上方说明）
ENV DSH_BIN=/npx/node_modules/.bin/dsh
EXPOSE 8407
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.QUANT_V3_PORT||8407)+'/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "server/index.mjs"]
